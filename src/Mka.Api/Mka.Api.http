@hostAddress = http://localhost:5054

### Login as technician
# @name techLogin
POST {{hostAddress}}/api/auth/login
Content-Type: application/json

{ "username": "tech1", "password": "Tech#1234" }

### Login as supervisor
# @name superLogin
POST {{hostAddress}}/api/auth/login
Content-Type: application/json

{ "username": "super1", "password": "Super#1234" }

###
@techToken = {{techLogin.response.body.accessToken}}
@superToken = {{superLogin.response.body.accessToken}}

### Technician creates equipment → expect 403
POST {{hostAddress}}/api/equipment
Authorization: Bearer {{techToken}}
Content-Type: application/json

{ "tag": "V-301", "name": "Production Separator", "type": "Vessel",
  "location": "CPF", "status": "Operational", "installedOn": "2021-08-15" }

### Supervisor creates equipment → expect 201
POST {{hostAddress}}/api/equipment
Authorization: Bearer {{superToken}}
Content-Type: application/json

{ "tag": "V-302", "name": "Test Separator", "type": "Vessel",
  "location": "CPF", "status": "Operational", "installedOn": "2022-01-10" }

###
GET {{hostAddress}}/api/equipment
Authorization: Bearer {{token}}

###
GET {{hostAddress}}/api/workorder?equipmentId=1

###
GET {{hostAddress}}/api/workorder/1

###
POST {{hostAddress}}/api/workorder
Content-Type: application/json

{
  "Title": "Generator Maintenance",
  "Description": "Generator Change Oil & Filters",
  "EquipmentId": "1",
  "AssignedTo": "Ali Hamid"
}

###
POST {{hostAddress}}/api/workorder
Content-Type: application/json

{
  "title": "Fix",
  "description": "Pump is noisy",
  "equipmentId": 0,
  "priority": 99
}






